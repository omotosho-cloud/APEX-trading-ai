NODE_ENV=development
PORT=3001

# Supabase
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Database
DATABASE_URL=postgresql://user:pass@host:5432/apex_db
TIMESCALE_URL=postgresql://user:pass@host:5432/apex_timescale

# Redis (Upstash — for cache/API reads)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Redis (ioredis connection string — for BullMQ job queues)
REDIS_URL="redis-cli --tls -u redis://default:gQAAAAAAARG-AAIncDFiNzExMzZjYTdjMjI0YzAzOWU0NTJjYTE4ODBhMzYzZnAxNzAwNzg@advanced-ostrich-70078.upstash.io:6379"

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars
CRON_SECRET=your_cron_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Deriv / Binary.com (Synthetic Indices) ────────────────────────────────────
# Register a free app at https://api.deriv.com/ to get your app_id.
# The default 1089 is Deriv's public demo app_id — fine for development
# but you should register your own for production.
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=111664
# API token — create at https://legacy-api.deriv.com/dashboard/
# Needed for authenticated history access. Keep this private, never commit it.
DERIV_API_TOKEN=your_deriv_api_token_here

# ── Twelve Data (Forex — optional if only trading synthetics) ─────────────────
TWELVE_DATA_API_KEY=your_twelve_data_key

# ── Signal engine thresholds ──────────────────────────────────────────────────
SIGNAL_CONFIDENCE_THRESHOLD=50
